<Window x:Class="PriceCompare.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PriceCompare"
        Width="1320"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        Background="#F8FAFC"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="PriceCompare"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#0F172A" />
                <TextBlock Text="Local XLSX / CSV price list comparison"
                           Foreground="#64748B" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Compare"
                        Command="{Binding CompareCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White" />
                <Button Content="Export Report"
                        Command="{Binding ExportReportCommand}" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="OLD PRICE LIST">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Select file"
                                Command="{Binding SelectOldFileCommand}" />
                        <StackPanel>
                            <TextBlock Text="{Binding OldFile.FileName}" FontWeight="SemiBold" />
                            <TextBlock Foreground="#64748B">
                                <Run Text="{Binding OldFile.RowCount, StringFormat={}{0:N0}}" />
                                <Run Text=" rows" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0"
                                 IsEnabled="{Binding IsInputEnabled}">
                        <StackPanel>
                            <TextBlock Text="SKU" />
                            <ComboBox ItemsSource="{Binding OldFile.Headers}"
                                      SelectedItem="{Binding OldFile.SkuColumn}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Name" />
                            <ComboBox ItemsSource="{Binding OldFile.OptionalHeaders}"
                                      ItemTemplate="{StaticResource OptionalHeaderTemplate}"
                                      SelectedItem="{Binding OldFile.NameColumn}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Price" />
                            <ComboBox ItemsSource="{Binding OldFile.Headers}"
                                      SelectedItem="{Binding OldFile.PriceColumn}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Stock" />
                            <ComboBox ItemsSource="{Binding OldFile.OptionalHeaders}"
                                      ItemTemplate="{StaticResource OptionalHeaderTemplate}"
                                      SelectedItem="{Binding OldFile.StockColumn}" />
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="NEW PRICE LIST">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Select file"
                                Command="{Binding SelectNewFileCommand}" />
                        <StackPanel>
                            <TextBlock Text="{Binding NewFile.FileName}" FontWeight="SemiBold" />
                            <TextBlock Foreground="#64748B">
                                <Run Text="{Binding NewFile.RowCount, StringFormat={}{0:N0}}" />
                                <Run Text=" rows" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0"
                                 IsEnabled="{Binding IsInputEnabled}">
                        <StackPanel>
                            <TextBlock Text="SKU" />
                            <ComboBox ItemsSource="{Binding NewFile.Headers}"
                                      SelectedItem="{Binding NewFile.SkuColumn}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Name" />
                            <ComboBox ItemsSource="{Binding NewFile.OptionalHeaders}"
                                      ItemTemplate="{StaticResource OptionalHeaderTemplate}"
                                      SelectedItem="{Binding NewFile.NameColumn}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Price" />
                            <ComboBox ItemsSource="{Binding NewFile.Headers}"
                                      SelectedItem="{Binding NewFile.PriceColumn}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Stock" />
                            <ComboBox ItemsSource="{Binding NewFile.OptionalHeaders}"
                                      ItemTemplate="{StaticResource OptionalHeaderTemplate}"
                                      SelectedItem="{Binding NewFile.StockColumn}" />
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Filter:" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatus}" />

                <TextBlock Grid.Column="3" Text="Search:" VerticalAlignment="Center" />
                <TextBox Grid.Column="4"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by SKU or name" />

                <TextBlock Grid.Column="5"
                           Text="{Binding StatusText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#475569" />
            </Grid>
        </Border>

        <TabControl Grid.Row="3">
            <TabItem Header="Results">
                <DataGrid ItemsSource="{Binding ResultsView}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          RowHeaderWidth="0"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Old Price" Binding="{Binding OldPrice, StringFormat=N2}" Width="105" />
                        <DataGridTextColumn Header="New Price" Binding="{Binding NewPrice, StringFormat=N2}" Width="105" />
                        <DataGridTextColumn Header="Difference" Binding="{Binding PriceDifference, StringFormat=+0.00;-0.00;0.00}" Width="110" />
                        <DataGridTextColumn Header="Difference %" Binding="{Binding PriceDifferencePercent, StringFormat=+0.00%;-0.00%;0.00%}" Width="115" />
                        <DataGridTextColumn Header="Old Stock" Binding="{Binding OldStock, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="New Stock" Binding="{Binding NewStock, StringFormat=N2}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Validation issues">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Import issues" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ValidationIssues}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" />
                            <DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="80" />
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Duplicate groups" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding DuplicateGroups}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" />
                            <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="140" />
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <UniformGrid Columns="6">
                <StackPanel>
                    <TextBlock Text="Added" Foreground="#64748B" />
                    <TextBlock Text="{Binding AddedCount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Removed" Foreground="#64748B" />
                    <TextBlock Text="{Binding RemovedCount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Changed" Foreground="#64748B" />
                    <TextBlock Text="{Binding ChangedCount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Unchanged" Foreground="#64748B" />
                    <TextBlock Text="{Binding UnchangedCount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Errors" Foreground="#64748B" />
                    <TextBlock Text="{Binding ErrorCount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Duplicates" Foreground="#64748B" />
                    <TextBlock Text="{Binding DuplicateCount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
